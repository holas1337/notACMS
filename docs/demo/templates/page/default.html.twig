{% extends 'base.html.twig' %}

{% block title %}{{ content.title() }} | {{ site_name }}{% endblock %}
{% block meta_description %}{{ content.description() ?: content.excerpt(meta_description_length) }}{% endblock %}
{% block og_title %}{{ content.title() }}{% endblock %}

{% block body %}
<div class="container container--prose">

    {% set current_path = app.request.pathInfo %}
    {{ include('components/breadcrumb.html.twig', { breadcrumbs: [
        { label: site_name, url: path('home_' ~ locale) },
        { label: content.title() }
    ] }) }}

    <article data-pagefind-body>
        <header class="page-header">
            <h1 data-pagefind-meta="title">{{ content.title() }}</h1>
            {% if content.description() %}
            <p class="page-header-desc">{{ content.description() }}</p>
            {% endif %}
        </header>

        <div class="prose">
            {{ content.htmlContent|raw }}
        </div>
    </article>
</div>
{% endblock %}

{% block javascripts %}
{% if content.hasToc() %}
<script src="{{ asset('local/table-of-contents.js') }}" defer></script>
{% endif %}
{% endblock %}
