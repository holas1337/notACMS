{% extends 'base.html.twig' %}

{% block title %}Error {{ status_code }} | {{ site_name }}{% endblock %}
{% block meta_description %}Error {{ status_code }}: {{ status_text }}{% endblock %}

{% block body %}
<div class="error-page">
    <div class="error-page__card">
        <div class="error-page__code">{{ status_code ?? '404' }}</div>
        <h1 class="error-page__title">{{ 'error.title'|trans }}</h1>
        <p class="error-page__message">{{ status_text }}</p>
        <a href="{{ path('home_' ~ locale) }}" class="btn btn-primary">{{ 'error.go_home'|trans }}</a>
    </div>
</div>
{% endblock %}
