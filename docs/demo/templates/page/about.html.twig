{% extends 'base.html.twig' %}

{% block title %}{{ content.title() }} | {{ site_name }}{% endblock %}
{% block meta_description %}{{ content.description() ?: content.excerpt(meta_description_length) }}{% endblock %}
{% block og_title %}{{ content.title() }}{% endblock %}

{% block structured_data %}{{ json_ld(structured_data().person(
    site_author.name,
    site_base_url,
    'about.role'|trans,
    'about.headline'|trans,
    site_author.email ?? null,
    [],
    site_social|map((url, network) => url)
)) }}{% endblock %}

{% block body %}
<article class="page-content" data-pagefind-body>

    {{ include('components/about_profile.html.twig', {
        author: site_author,
        headline: 'about.headline'|trans
    }) }}

    <div class="about-bio prose">
        {{ content.htmlContent|raw }}
    </div>

    {% if site_author.skills is not empty %}
    <section class="about-skills">
        <h2 class="about-skills__title">{{ 'about.skills_title'|trans }}</h2>
        <dl>
            {% for category, items in site_author.skills %}
            <div class="about-skills__group">
                <dt>{{ ('about.skills.' ~ category)|trans }}</dt>
                <dd>
                    {% for skill in items %}
                        <span class="tag-pill">{{ skill }}</span>
                    {% endfor %}
                </dd>
            </div>
            {% endfor %}
        </dl>
    </section>
    {% endif %}

    {% if site_author.recommendations is defined and site_author.recommendations is not empty %}
    <section class="about-recommendations">
        <h2 class="about-recommendations__title">{{ 'about.recommendations_title'|trans }}</h2>
        {% for rec in site_author.recommendations %}
        {{ include('components/recommendation_card.html.twig', {
            rec: rec,
            expand_label: 'about.recommendation_expand'|trans,
            collapse_label: 'about.recommendation_collapse'|trans,
            via_label: 'about.recommendation_via'|trans
        }) }}
        {% endfor %}
    </section>
    {% endif %}

    <p>
        <a href="{{ path('contact_' ~ locale) }}" class="btn btn-primary">{{ 'about.cta_link'|trans }}</a>
    </p>

</article>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('local/recommendation-expand.js') }}" defer></script>
{% if content.hasToc() %}
<script src="{{ asset('local/table-of-contents.js') }}" defer></script>
{% endif %}
{% endblock %}
