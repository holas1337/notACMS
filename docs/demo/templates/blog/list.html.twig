{% extends 'base.html.twig' %}

{% block title %}{{ index_content ? index_content.menuLabel() : (content_item('blog', locale).menuLabel() ?? 'blog.title'|trans) }} | {{ site_name }}{% endblock %}
{% block meta_description %}{% if filter_type is same as('tag') %}{{ 'releases.meta_tagged'|trans({'%tag%': filter_value, '%site_name%': site_name}) }}{% else %}{{ 'releases.meta_description'|trans({'%site_name%': site_name}) }}{% endif %}{% endblock %}
{% block og_title %}{{ index_content ? index_content.menuLabel() : (content_item('blog', locale).menuLabel() ?? 'blog.title'|trans) }}{% endblock %}

{% block body %}

<div class="page-content">

    {# Page header #}
    <div class="page-header">
        {{ include('components/breadcrumb.html.twig', { breadcrumbs: breadcrumbs(index_content|default(null), locale, {home_label: site_name}) }) }}
        <h1>
            {% if filter_type is same as('tag') %}
                {{ 'releases.tagged_heading'|trans }} <span class="text-accent">#{{ filter_value }}</span>
            {% else %}
                {{ index_content ? index_content.menuLabel() : (content_item('blog', locale).menuLabel() ?? 'blog.title'|trans) }}
            {% endif %}
        </h1>
        <p class="page-header-desc">
            {% if filter_type is same as('tag') %}
                {{ 'releases.tagged_desc'|trans({'%tag%': filter_value}) }}
            {% else %}
                {{ 'releases.description'|trans }}
            {% endif %}
        </p>
    </div>

    {# Release cards #}
    {% if posts is not empty %}
    <div class="releases-list" role="list">
        {% for post in posts %}
        {{ include('components/release_card.html.twig', { post: post, role: 'listitem' }) }}
        {% endfor %}
    </div>

    {% if filter_type is not defined or filter_type is null %}
        {{ include('components/pagination.html.twig', {
            base_url: path('blog_list_' ~ locale),
            paginated_route: 'blog_list_paginated_' ~ locale,
            current_page: current_page,
            total_pages: total_pages,
        }) }}
    {% endif %}

    {% else %}
    <p class="releases-empty">{{ 'releases.empty'|trans }}</p>
    {% endif %}

</div>

{% endblock %}

{% block structured_data %}{% if posts is not empty %}{{ json_ld(structured_data().collectionPage(
    block('title')|striptags|trim,
    site_base_url ~ app.request.pathInfo,
    posts|map((post, i) => {
        "@type": "ListItem",
        "position": i + 1,
        "url": site_base_url ~ post.url()
    }),
    null,
    posts|length
)) }}{% endif %}{% endblock %}
