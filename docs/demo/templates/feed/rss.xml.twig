<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
     xmlns:atom="http://www.w3.org/2005/Atom"
     xmlns:content="http://purl.org/rss/1.0/modules/content/"
     xmlns:media="http://search.yahoo.com/mrss/">
    <channel>
        <title>{{ site_name }}</title>
        <link>{{ site_base_url }}{{ path('home_' ~ locale) }}</link>
        <description><![CDATA[{{ site_description }}]]></description>
        <language>{{ locale }}</language>
        <atom:link href="{{ site_base_url }}{{ path('rss_' ~ locale) }}" rel="self" type="application/rss+xml"/>
        {% if posts is not empty %}
        <lastBuildDate>{{ posts[0].date()|date('D, d M Y H:i:s +0000') }}</lastBuildDate>
        {% endif %}
        {% for post in posts %}
        <item>
            <title><![CDATA[{{ post.title() }}]]></title>
            <link>{{ site_base_url }}{{ post.url() }}</link>
            <guid isPermaLink="true">{{ site_base_url }}{{ post.url() }}</guid>
            {% if post.date() %}
            <pubDate>{{ post.date()|date('D, d M Y H:i:s +0000') }}</pubDate>
            {% endif %}
            <description><![CDATA[{{ post.excerpt(400) }}]]></description>
            <content:encoded><![CDATA[{{ post.htmlContent|raw }}]]></content:encoded>
            {% if post.image() %}
            <media:content url="{{ site_base_url }}{{ post.image() }}" medium="image" type="image/webp" width="1280" height="720"/>
            {% endif %}
            {% if post.category() %}
            <category><![CDATA[{{ post.category() }}]]></category>
            {% endif %}
            {% for tag in post.tags() %}
            <category><![CDATA[{{ tag }}]]></category>
            {% endfor %}
        </item>
        {% endfor %}
    </channel>
</rss>
