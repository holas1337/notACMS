                    </svg>
                    <p>{{ site_description }}</p>
                </div>

                <div class="footer-links">
                    <div class="footer-col">
                        <h4>{{ 'site.docs'|trans }}</h4>
                        <ul>
                            <li><a href="{{ content_url('manual', locale) }}">{{ content_item('manual', locale).menuLabel() }}</a></li>
                            <li><a href="{{ content_url('architecture', locale) }}">{{ content_item('architecture', locale).menuLabel() }}</a></li>
                            <li><a href="{{ content_url('customization', locale) }}">{{ content_item('customization', locale).menuLabel() }}</a></li>
                            <li><a href="{{ content_url('locales', locale) }}">{{ content_item('locales', locale).menuLabel() }}</a></li>
                            <li><a href="{{ content_url('styleguide', locale) }}">{{ content_item('styleguide', locale).menuLabel() }}</a></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <h4>{{ 'site.project'|trans }}</h4>
                        <ul>
                            <li><a href="{{ path('blog_list_' ~ locale) }}">{{ content_item('blog', locale).menuLabel() }}</a></li>
                            <li><a href="{{ site_social.github ?? '#' }}" target="_blank" rel="noopener noreferrer">
                                {{ 'site.github'|trans }} <i class="ph ph-arrow-square-out" aria-hidden="true"></i>
                            </a></li>
                            {% set privacy_item = content_item('privacy-policy', locale) %}
                            {% if privacy_item is not null %}
                            <li><a href="{{ privacy_item.url() }}">{{ privacy_item.menuLabel() }}</a></li>
                            {% endif %}
                        </ul>
                    </div>
                    <div class="footer-col">
                        <h4>{{ 'site.author'|trans }}</h4>
                        <ul>
                            <li><a href="{{ content_url('about', locale) }}">{{ content_item('about', locale).menuLabel() }}</a></li>
                            <li><a href="{{ site_author.url ?? '#' }}" target="_blank" rel="noopener noreferrer">
                                holas.pl <i class="ph ph-arrow-square-out" aria-hidden="true"></i>
                            </a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; {{ "now"|date("Y") }} {{ site_name }}. {{ 'site.open_source'|trans }}.</p>
                <p>{{ 'site.built_with'|trans }} &mdash; <a href="{{ site_social.github ?? '#' }}" target="_blank" rel="noopener noreferrer">{{ 'site.github'|trans }}</a></p>
            </div>
        </div>
    </footer>

    {% block javascripts %}{% endblock %}

    {# ── Search overlay ── #}
    <div class="search-overlay" id="site-search" aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'search.title'|trans }}">
        <div class="search-overlay__panel">
            <div class="search-overlay__header">
                <i class="ph ph-magnifying-glass search-overlay__icon" aria-hidden="true"></i>
                <input class="search-overlay__input"
                       id="site-search-input"
                       name="q"
                       type="search"
                       placeholder="{{ 'search.placeholder'|trans }}"
                       autocomplete="off"
                       spellcheck="false">
                <button class="search-overlay__close" aria-label="{{ 'search.close'|trans }}">
                    <i class="ph ph-x" aria-hidden="true"></i>
                    <kbd>Esc</kbd>
                </button>
            </div>
            <div class="search-overlay__results" id="search-overlay-results" aria-live="polite" aria-label="{{ 'search.title'|trans }}"></div>
            <div class="search-overlay__footer">
                <span><kbd>↑</kbd><kbd>↓</kbd> {{ 'search.hint_navigate'|trans }}</span>
                <span><kbd>↵</kbd> {{ 'search.hint_open'|trans }}</span>
                <span><kbd>Esc</kbd> {{ 'search.hint_close'|trans }}</span>
                <span class="search-overlay__shortcut-hint"><kbd>⌘</kbd><kbd>K</kbd> / <kbd>Ctrl</kbd><kbd>K</kbd> {{ 'search.hint_anywhere'|trans }}</span>
            </div>
        </div>
    </div>
    <script src="{{ asset('local/search-overlay.js') }}" defer></script>

    {{ include('components/cookie_banner.html.twig', {
        privacy_url: content_url('privacy-policy', locale)
    }) }}
    <script src="{{ asset('local/cookie-banner.js') }}" defer></script>

    {% if cf_analytics_token %}
        <script defer src="https://static.cloudflareinsights.com/beacon.min.js"
                data-cf-beacon='{"token": "{{ cf_analytics_token }}"}'></script>
    {% endif %}

</body>
</html>
