<!DOCTYPE html>
<html lang="{{ locale ?? site_default_locale }}"
      data-theme="light"
      data-locales="{{ site_locales_list|join(',') }}"
      data-default-locale="{{ site_default_locale }}"
      data-code-copy-label="{{ 'code.copy'|trans }}"
      data-code-copied-label="{{ 'code.copied'|trans }}"
      data-code-copy-aria="{{ 'code.copy_aria'|trans }}"
      data-toc-label="{{ 'toc.title'|trans }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {# Anti-flash: apply saved theme immediately, before modules load #}
    <script>(function(){try{var t=localStorage.getItem('notacms-theme');if(!t){t=window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light';}document.documentElement.setAttribute('data-theme',t);}catch(e){}})();</script>

    <title>{% block title %}{{ site_name }}{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}{{ site_description }}{% endblock %}">
    {% block robots %}<meta name="robots" content="max-image-preview:large, max-snippet:-1">{% endblock %}

    {% block favicons %}
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="{{ asset('images/favicon.svg') }}" type="image/svg+xml">
    <link rel="apple-touch-icon" href="{{ asset('images/apple-touch-icon.png') }}">
    {% endblock %}

    {# hreflang SEO tags #}
    {% if content is defined and content is not null and content.directoryKey() %}
        {% set tk = content.directoryKey() %}
        {% if translation_map is defined and translation_map[tk] is defined %}
            {% for lang, url in translation_map[tk] %}
                <link rel="alternate" hreflang="{{ lang }}" href="{{ site_base_url }}{{ url }}">
            {% endfor %}
            {% if translation_map[tk][site_default_locale] is defined %}
                <link rel="alternate" hreflang="x-default" href="{{ site_base_url }}{{ translation_map[tk][site_default_locale] }}">
            {% endif %}
        {% endif %}
    {% endif %}

    {# Browser language detection — sync, no defer/async, fires before content renders #}
    {% block locale_redirect %}
    <script src="{{ asset('local/locale-redirect.js') }}"></script>
    {% endblock %}

    {# Open Graph #}
    <meta property="og:type" content="{% block og_type %}website{% endblock %}">
    <meta property="og:site_name" content="{{ site_name }}">
    <meta property="og:title" content="{% block og_title %}{{ site_name }}{% endblock %}">
    <meta property="og:description" content="{{ block('meta_description') }}">
    {% if content is defined and content is not null and content.image() %}
    <meta property="og:image" content="{{ site_base_url ~ content.image() }}">
    <meta property="og:image:width" content="1280">
    <meta property="og:image:height" content="720">
    <meta property="og:image:type" content="image/webp">
    {% else %}
    {% block og_default_image %}
    <meta property="og:image" content="{{ site_base_url ~ asset('local/images/og-default.jpg') }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:type" content="image/jpeg">
    {% endblock %}
    {% endif %}
    <meta property="og:url" content="{{ site_base_url }}{{ app.request.pathInfo }}">
    <meta property="og:locale" content="{{ site_locales[locale].og_locale ?? locale }}">
    {% for alt_locale in site_locales_list %}
    {% if alt_locale is not same as(locale) %}
    <meta property="og:locale:alternate" content="{{ site_locales[alt_locale].og_locale ?? alt_locale }}">
    {% endif %}
    {% endfor %}
    {% block og_article_meta %}{% endblock %}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ block('og_title') }}">
    <meta name="twitter:description" content="{{ block('meta_description') }}">
    <meta name="twitter:image" content="{{ content is defined and content is not null and content.image() ? site_base_url ~ content.image() : site_base_url ~ asset('local/images/og-default.jpg') }}">

    <link rel="canonical" href="{{ site_base_url }}{{ app.request.pathInfo }}">
    <link rel="alternate" type="application/rss+xml" title="{{ site_name }} RSS" href="{{ path('rss_' ~ locale) }}">

    {% if cf_analytics_token %}
    <link rel="preconnect" href="https://static.cloudflareinsights.com" crossorigin>
    {% endif %}

    {# Google Fonts: Inter + JetBrains Mono #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

    {% block head_preconnect %}{% endblock %}

    {% block stylesheets %}
        {{ importmap('app-local') }}
    {% endblock %}

    {# Phosphor Icons #}
    <script src="https://unpkg.com/@phosphor-icons/web@2.1.1" defer></script>

{% block structured_data %}{{ json_ld(structured_data().webSite(
    site_name,
    site_base_url,
    structured_data().person(site_author.name, site_base_url)
)) }}{% endblock %}
</head>
<body class="locale-{{ locale ?? site_default_locale }}">
    <a href="#main-content" class="skip-link">{{ 'nav.skip_to_content'|trans }}</a>

    <header class="site-header">
        <div class="site-header-inner">
            <a href="{{ path('home_' ~ locale) }}" class="site-logo" aria-label="{{ site_name }}">
