                </svg>
            </a>

            <nav class="site-nav" aria-label="{{ 'nav.main'|trans }}">
                {% block navigation %}
                    {{ include('components/navigation.html.twig') }}
                {% endblock %}
            </nav>
        </div>
    </header>

    <main class="site-main" id="main-content">
        {% block body %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="site-footer-inner">
                <div class="footer-brand">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 248 85" height="24" style="width: auto" aria-hidden="true" role="presentation">
                        <path fill="#FFB000" d="M22.12 57L19.32 57L20.88 48.60L17.40 48.60L17.40 46L21.32 46L22.68 38.80L18.80 38.80L18.80 36.20L23.12 36.20L24.68 27.80L27.48 27.80L25.92 36.20L32.32 36.20L33.88 27.80L36.68 27.80L35.12 36.20L38.60 36.20L38.60 38.80L34.68 38.80L33.32 46L37.20 46L37.20 48.60L32.88 48.60L31.32 57L28.52 57L30.08 48.60L23.68 48.60L22.12 57ZM25.48 38.80L24.12 46L30.52 46L31.88 38.80L25.48 38.80Z"/>
