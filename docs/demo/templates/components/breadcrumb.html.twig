{#
    Generic breadcrumb component.
    Parameters:
        breadcrumbs — array of {label, url?} items. Last item has no url (current page).
#}
<nav class="breadcrumb" aria-label="{{ 'breadcrumb.label'|trans }}">
    {% for crumb in breadcrumbs %}
        {% if crumb.url is defined and crumb.url and not loop.last %}
            <a href="{{ crumb.url }}">{{ crumb.label }}</a>
        {% elseif loop.last %}
            <span aria-current="page">{{ crumb.label }}</span>
        {% else %}
            <span>{{ crumb.label }}</span>
        {% endif %}
        {% if not loop.last %}
            <span class="breadcrumb-sep" aria-hidden="true">/</span>
        {% endif %}
    {% endfor %}
</nav>
{{ json_ld(structured_data().breadcrumbList(
    breadcrumbs|map((crumb, i) => {
        "@type": "ListItem",
        "position": i + 1,
        "name": crumb.label,
        "item": crumb.url is defined and crumb.url ? site_base_url ~ crumb.url : null
    })
)) }}
