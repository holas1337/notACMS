{% extends 'base.html.twig' %}

{# Compute archive date label once — used across title, og_title, meta_description, breadcrumb, h1 #}
{% if filter_type is same as('archive') %}
    {% set archive_date = archive_month is defined
        ? ('%04d-%02d-01'|format(archive_year, archive_month))|date('F Y')
        : archive_year %}
{% endif %}

{% block title %}
    {% if filter_type is same as('category') %}
        {{ filter_value|capitalize }} | {{ site_name }}
    {% elseif filter_type is same as('tag') %}
        #{{ filter_value }} | {{ site_name }}
    {% elseif filter_type is same as('archive') %}
        {{ archive_date }} | {{ site_name }}
    {% else %}
        {{ 'nav.blog'|trans }} | {{ site_name }}
    {% endif %}
{% endblock %}

{% block og_title %}{%- if filter_type is same as('category') -%}{{ 'blog.category'|trans }}: {{ filter_value }}{%- elseif filter_type is same as('tag') -%}#{{ filter_value }}{%- elseif filter_type is same as('archive') -%}{{ 'blog.archive'|trans }}: {{ archive_date }}{%- else -%}{{ 'nav.blog'|trans }}{%- endif -%}{% endblock %}

{% block meta_description %}{% if filter_type is same as('category') %}{{ 'blog.meta.category'|trans({'%category%': filter_value|capitalize}) }}{% elseif filter_type is same as('tag') %}{{ 'blog.meta.tag'|trans({'%tag%': filter_value}) }}{% elseif filter_type is same as('archive') %}{% if archive_month is defined %}{{ 'blog.meta.archive_month'|trans({'%date%': archive_date}) }}{% else %}{{ 'blog.meta.archive_year'|trans({'%year%': archive_year}) }}{% endif %}{% else %}{{ 'blog.meta.index'|trans }}{% endif %}{% endblock %}

{% block body %}
{% set crumbs = [{label: 'nav.home'|trans, url: path('home_' ~ locale)}] %}
{% if filter_type is defined and filter_type is not null %}
    {% set crumbs = crumbs|merge([{label: 'nav.blog'|trans, url: path('blog_list_' ~ locale)}]) %}
    {% if filter_type is same as('category') %}
        {% set crumbs = crumbs|merge([{label: filter_value}]) %}
    {% elseif filter_type is same as('tag') %}
        {% set crumbs = crumbs|merge([{label: '#' ~ filter_value}]) %}
    {% elseif filter_type is same as('archive') %}
        {% set crumbs = crumbs|merge([{label: archive_date}]) %}
    {% endif %}
{% else %}
    {% set crumbs = crumbs|merge([{label: 'nav.blog'|trans}]) %}
{% endif %}
{{ include('components/breadcrumb.html.twig', { breadcrumbs: crumbs }) }}

<header class="archive-header">
    {% if filter_type is same as('category') %}
        <h1>{{ 'blog.category'|trans }}: {{ filter_value }}</h1>
    {% elseif filter_type is same as('tag') %}
        <h1>{{ 'blog.tags'|trans }}: #{{ filter_value }}</h1>
    {% elseif filter_type is same as('archive') %}
        <h1>{{ 'blog.archive'|trans }}: {{ archive_date }}</h1>
    {% else %}
        <h1>{{ 'nav.blog'|trans }}</h1>
    {% endif %}
</header>

{% if posts is not empty %}
    <div class="post-list">
    {% for post in posts %}
        {% with { post: post, featured: post.isPinned(), lcp: loop.index0 is same as(0) } %}
            {{ include('components/post_card.html.twig') }}
        {% endwith %}
    {% endfor %}
    </div>

    {% if filter_type is not defined or filter_type is null %}
        {{ include('components/pagination.html.twig', {
            base_url: path('blog_list_' ~ locale),
            paginated_route: 'blog_list_paginated_' ~ locale,
            current_page: current_page,
            total_pages: total_pages,
        }) }}
    {% endif %}
{% else %}
    <p class="no-posts">{{ 'blog.no_posts'|trans }}</p>
{% endif %}
{% endblock %}

{% block structured_data %}
{% if posts is not empty %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "{{ block('title')|striptags|trim }}",
    "url": "{{ site_base_url }}{{ app.request.pathInfo }}",
    "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ posts|length }},
        "itemListElement": [
            {% for post in posts %}
            {
                "@type": "ListItem",
                "position": {{ loop.index }},
                "url": "{{ site_base_url }}{{ post.url() }}"
            }{% if not loop.last %},{% endif %}
            {% endfor %}
        ]
    }
}
</script>
{% endif %}
{% endblock %}
