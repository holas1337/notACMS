<article class="post-card{% if post.isDraft() %} post-card--draft{% elseif post.isScheduled() %} post-card--scheduled{% endif %}{% if featured is defined and featured %} post-card--featured{% endif %}">
    {% if post.image() %}
    <div class="post-card-image">
        <a href="{{ post.url() }}">
            {{ include('components/responsive_img.html.twig', {
                src: post.image(),
                alt: post.imageAlt(),
                sizes: '(max-width: 48em) 100vw, 600px',
                loading: (lcp is defined and lcp is same as(true)) ? 'eager' : 'lazy',
                fetchpriority: (lcp is defined and lcp is same as(true)) ? 'high' : null
            }) }}
        </a>
    </div>
    {% endif %}
    <div class="post-card-body">
        <p class="post-card-meta">
            {% if post.category() %}<span class="meta-category">{{ post.category() }}</span>{% endif %}
            {% if post.category() and post.date() %}&nbsp;&bull;&nbsp;{% endif %}
            {% if post.date() %}{{ post.date()|date(site_locales[locale].date_format) }}{% endif %}
        </p>
        <h2 class="post-card-title">
            <a href="{{ post.url() }}">{{ post.title() }}</a>
            {% if post.isDraft() %}
                <span class="post-card-badge post-card-badge--draft">{{ 'badge.draft'|trans }}</span>
            {% elseif post.isScheduled() %}
                <span class="post-card-badge post-card-badge--planned">{{ 'badge.planned'|trans }}</span>
            {% else %}
                {% if featured is defined and featured or post.isPinned() %}
                    <span class="post-card-badge">{{ 'badge.pinned'|trans }}</span>
                {% endif %}
                {% set now_ts = "now"|date('U') %}
                {% set new_threshold = new_post_days * 86400 %}
                {% if post.date() and (now_ts - post.date()|date('U')) < new_threshold %}
                    <span class="post-card-badge post-card-badge--new">{{ 'badge.new'|trans }}</span>
                {% elseif post.updatedDate() and (now_ts - post.updatedDate()|date('U')) < new_threshold %}
                    <span class="post-card-badge post-card-badge--updated">{{ 'badge.updated'|trans }}</span>
                {% endif %}
            {% endif %}
        </h2>
        <p class="post-card-excerpt">{{ post.excerpt() }}</p>
        <footer class="post-card-footer">
            <a href="{{ post.url() }}" class="read-more">{{ 'blog.read_more'|trans }} &rarr;</a>
            {% if post.tags() is not empty %}
            <div class="post-tags">
                {% for tag in post.tags() %}
                    <a href="{{ path('blog_tag_' ~ locale, {tag: tag}) }}" class="tag">{{ tag }}</a>
                {% endfor %}
            </div>
            {% endif %}
        </footer>
    </div>
</article>
