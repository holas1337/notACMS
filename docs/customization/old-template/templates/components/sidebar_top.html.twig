{% if sidebar is defined %}
<div class="widget widget-search">
    <h3 class="widget-title">{{ 'sidebar.search'|trans }}</h3>
    <form action="{{ path('search_' ~ locale) }}" method="get" class="search-form">
        <input type="search" name="q" placeholder="{{ 'sidebar.search'|trans }}…"
               class="form-control search-input" aria-label="{{ 'sidebar.search'|trans }}">
        <button type="submit" class="search-submit" aria-label="{{ 'sidebar.search'|trans }}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </button>
    </form>
</div>
{% endif %}
