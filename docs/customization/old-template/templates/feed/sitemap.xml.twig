<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
    {% macro hreflang(translation_map, item, default_locale) %}
        {% set tk = item.directoryKey() %}
        {% if tk and translation_map[tk] is defined %}
            {% for lang, url in translation_map[tk] %}
            <xhtml:link rel="alternate" hreflang="{{ lang }}" href="{{ site_base_url }}{{ url }}"/>
            {% endfor %}
            {% if translation_map[tk][default_locale] is defined %}
            <xhtml:link rel="alternate" hreflang="x-default" href="{{ site_base_url }}{{ translation_map[tk][default_locale] }}"/>
            {% endif %}
        {% endif %}
    {% endmacro %}

    {% set home_urls = {} %}
    {% for locale in site_locales_list %}
        {% set home_urls = home_urls|merge({(locale): path('home_' ~ locale)}) %}
    {% endfor %}

    {% for locale, items in items_by_locale %}
    {% set locale_home = home_urls[locale] ?? '/' %}
    {% for item in items %}
    {% if not item.isDraft() and not item.isScheduled() and item.url() %}
    <url>
        <loc>{{ site_base_url }}{{ item.url() }}</loc>
        {% if item.updatedDate() %}
        <lastmod>{{ item.updatedDate()|date('Y-m-d') }}</lastmod>
        {% elseif item.date() %}
        <lastmod>{{ item.date()|date('Y-m-d') }}</lastmod>
        {% endif %}
        <changefreq>{{ item.url() is same as(locale_home) ? 'daily' : (item.isIndex() ? 'weekly' : 'monthly') }}</changefreq>
        <priority>{{ item.url() is same as(locale_home) ? '1.0' : (item.isIndex() ? '0.8' : '0.6') }}</priority>
        {% if item.image() %}
        <image:image>
            <image:loc>{{ site_base_url }}{{ item.image() }}</image:loc>
            {% if item.imageAlt() %}<image:title>{{ item.imageAlt()|e }}</image:title>{% endif %}
        </image:image>
        {% endif %}
        {{ _self.hreflang(translation_map, item, site_default_locale) }}
    </url>
    {% endif %}
    {% endfor %}
    {% endfor %}

</urlset>
