{# Horizontal post card — image on left, content on right
   Expects: post (ContentItem), featured (boolean, optional), lcp (boolean, optional) #}
<article class="post-card post-card--horizontal{% if post.isDraft() %} post-card--draft{% elseif post.isScheduled() %} post-card--scheduled{% endif %}">
    {% if post.image() %}
    <div class="post-card__image">
        <img src="{{ post.image() }}" alt="{{ post.imageAlt() }}" {{ (lcp ?? false) ? 'fetchpriority="high"' : 'loading="lazy"' }}>
    </div>
    {% endif %}

    <div class="post-card__content">
        <p class="post-card-meta">
            {% if post.category() %}{{ post.category() }}<span class="post-meta-sep">&bull;</span>{% endif %}
            {% if post.date() %}{{ post.date()|date(site_locales[locale].date_format) }}{% endif %}
        </p>
        <h2>
            <a href="{{ post.url() }}">{{ post.title() }}</a>
            {% if post.isDraft() %}<span class="badge">[{{ 'badge.draft'|trans }}]</span>{% endif %}
            {% if post.isScheduled() %}<span class="badge">[{{ 'badge.planned'|trans }}]</span>{% endif %}
            {% if featured is defined and featured or post.isPinned() %}<span class="badge">{{ 'badge.pinned'|trans }}</span>{% endif %}
            {% set now_ts = "now"|date('U') %}
            {% set new_threshold = new_post_days * 86400 %}
            {% if not post.isDraft() and not post.isScheduled() and post.date() and (now_ts - post.date()|date('U')) < new_threshold %}
                <span class="badge">{{ 'badge.new'|trans }}</span>
            {% elseif post.updatedDate() and (now_ts - post.updatedDate()|date('U')) < new_threshold %}
                <span class="badge">{{ 'badge.updated'|trans }}</span>
            {% endif %}
        </h2>
        <p>{{ post.excerpt() }}</p>
        <footer class="flex-between flex-wrap gap-md">
            <a href="{{ post.url() }}">{{ 'blog.read_more'|trans }} &rarr;</a>
            {% if post.tags() is not empty %}
            <div class="post-tags">
                {% for tag in post.tags() %}
                    <a href="{{ path('blog_tag_' ~ locale, {tag: tag}) }}">#{{ tag }}</a>
                {% endfor %}
            </div>
            {% endif %}
        </footer>
    </div>
</article>
