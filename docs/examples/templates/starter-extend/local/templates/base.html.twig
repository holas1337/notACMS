{% extends '@base/base.html.twig' %}

{#
    Override the stylesheets block so that local.css loads AFTER the base app.css.

    importmap() processes entrypoints in order. 'app' is fully resolved first
    (discovering app.css), then 'app-local' (discovering local.css). Duplicates
    are skipped, so app.css keeps its earlier position:

        <link rel="stylesheet" href="…/app.css">    ← original styles
        <link rel="stylesheet" href="…/local.css">  ← your overrides
#}
{% block stylesheets %}
    {{ importmap(['app', 'app-local']) }}
{% endblock %}
