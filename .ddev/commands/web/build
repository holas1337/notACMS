#!/bin/bash
## Description: Build assets and static site
## Usage: build [--bare|--demo]
## Example: ddev build --demo

cd /var/www/html || exit 1

# ── Parse flags ──────────────────────────────────────────────────────────
SEED_MODE=""
for arg in "$@"; do
    case "$arg" in
        --bare|--demo)
            if [ -n "$SEED_MODE" ] && [ "$SEED_MODE" != "$arg" ]; then
                echo "ERROR: --bare and --demo are mutually exclusive" >&2
                exit 1
            fi
            SEED_MODE="$arg"
            ;;
        *)
            echo "ERROR: Unknown flag: $arg" >&2
            echo "Usage: ddev build [--bare|--demo]" >&2
            exit 1
            ;;
    esac
done

# ── Helpers ──────────────────────────────────────────────────────────────

# Check whether a directory contains only .gitkeep files (recursively).
# Returns 0 (true) if the dir is empty or only has .gitkeep, 1 (false) otherwise.
dir_is_empty() {
    local dir="$1"
    [ -d "$dir" ] || return 0
    local non_gitkeep
    non_gitkeep="$(find "$dir" -type f ! -name '.gitkeep' 2>/dev/null)"
    [ -z "$non_gitkeep" ]
}

# Check whether local/ as a whole has any real content across all subdirs.
local_has_content() {
    local subdirs=(content translations assets docs src templates docker)
    for sub in "${subdirs[@]}"; do
        if ! dir_is_empty "local/$sub"; then
            return 0
        fi
    done
    return 1
}

# ── Seed logic ───────────────────────────────────────────────────────────

if [ -n "$SEED_MODE" ]; then
    if [ ! -d local ]; then
        echo "==> local/ does not exist — creating and seeding ($SEED_MODE)"
        mkdir -p local
        SEED_SOURCE="docs/${SEED_MODE#--}"
        cp -r "$SEED_SOURCE/." local/
    elif local_has_content; then
        TIMESTAMP="$(date '+%Y-%m-%d-%H%M%S')"
        echo "==> local/ has content — backing up to local-$TIMESTAMP/"
        mv local "local-$TIMESTAMP"
        mkdir -p local
        SEED_SOURCE="docs/${SEED_MODE#--}"
        cp -r "$SEED_SOURCE/." local/
        echo "    Seeded from $SEED_SOURCE/"
    else
        echo "==> local/ exists but is empty — seeding ($SEED_MODE)"
        SEED_SOURCE="docs/${SEED_MODE#--}"
        cp -r "$SEED_SOURCE/." local/
    fi

    # Ensure og-default.jpg exists (both bare and demo may need it)
    if [ ! -f local/assets/images/og-default.jpg ]; then
        mkdir -p local/assets/images
        cp assets/images/og-default.jpg local/assets/images/og-default.jpg
    fi
else
    # No flag — seed demo if local/ is empty/missing, otherwise skip
    if [ ! -d local ] || ! local_has_content; then
        echo "==> local/ is empty or missing — seeding from docs/demo/"
        mkdir -p local
        cp -r docs/demo/. local/
        if [ ! -f local/assets/images/og-default.jpg ]; then
            mkdir -p local/assets/images
            cp assets/images/og-default.jpg local/assets/images/og-default.jpg
        fi
    else
        echo "==> local/ has existing content — skipping seed (use --bare or --demo to force)"
    fi
fi

# ── Build pipeline ───────────────────────────────────────────────────────

echo "==> Installing dependencies"
composer install --optimize-autoloader --no-interaction

echo "==> Removing dart-sass binary (architecture-specific)"
rm -rf var/dart-sass

echo "==> Clearing cache"
php bin/console cache:clear

echo "==> Compiling SCSS"
php bin/console sass:build

echo "==> Clearing compiled assets"
rm -rf public/assets

echo "==> Compiling assets"
php bin/console asset-map:compile

echo "==> Building static site"
php bin/console app:build -v

echo "==> Copying favicon.ico"
if [ -f local/assets/favicon.ico ]; then
    cp local/assets/favicon.ico public/favicon.ico
elif [ -f assets/images/favicon.ico ]; then
    cp assets/images/favicon.ico public/favicon.ico
fi

echo "==> Building search index"
npx --yes pagefind --site public/static --output-path public/pagefind

echo "==> Done."
