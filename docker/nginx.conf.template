server {
    listen 80;
    server_name _;
    root /app/public;
    index index.html;
    server_tokens off;

    # Docker's internal resolver — resolves upstream lazily at request time
    resolver 127.0.0.11 valid=10s;
    set $php_upstream php:9000;

    # Security headers
    add_header X-Frame-Options           "SAMEORIGIN"                       always;
    add_header X-Content-Type-Options    "nosniff"                          always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin"  always;
    add_header Permissions-Policy        "camera=(), microphone=(), geolocation=()" always;

    # Content-Security-Policy
    # Default is bare-theme-safe. Themes with external-origin assets (e.g. the
    # demo theme uses unpkg.com for Phosphor Icons and Google Fonts) seed a
    # local/docker/nginx/csp.conf override that redefines $csp before it is
    # emitted below.
    # Notes on the directives:
    #   script-src: 'unsafe-inline' for AssetMapper importmap; 'wasm-unsafe-eval' for Pagefind; data: for importmap CSS stubs
    #   Cloudflare entries support optional Turnstile captcha + Web Analytics beacon
    set $csp "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' data: challenges.cloudflare.com static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-src challenges.cloudflare.com; connect-src 'self' challenges.cloudflare.com cloudflareinsights.com;";

    # Site-specific overrides — place *.conf files in local/docker/nginx/
    # (auto-seeded on first deploy from docs/demo/docker/nginx/ or docs/bare/docker/nginx/)
    include /app/local/docker/nginx/*.conf;

    add_header Content-Security-Policy $csp always;

    # Contact form — only these routes go to PHP-FPM.
    # Matches /api/ (default locale) and /{locale}/api/ (any non-default locale).
    # Requires RUNTIME_PHP_ENABLED=true to start the php container; otherwise
    # /api/ requests return 502 (lazy DNS resolution via the resolver above keeps
    # nginx starting cleanly even when the upstream is absent).
    location ~ ^/([a-z]\{2\}/)?api/ {
        fastcgi_pass $php_upstream;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /app/public/index.php;
        fastcgi_param SCRIPT_NAME     /index.php;
        fastcgi_param DOCUMENT_ROOT   /app/public;
        fastcgi_read_timeout 30;
    }

    # Error pages — default locale fallback
    # Locale-specific error pages are in local/docker/nginx/error-pages.conf (auto-seeded on first deploy)
    error_page 404 /404.html;
    error_page 500 502 503 504 /500.html;

    # Hashed assets (CSS, JS, fonts) — safe to cache for 1 year (hash in filename changes on deploy)
    # Assets are at public/assets/ (not public/static/assets/), so use $uri not /static$uri
    location ^~ /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Media images — not hashed, 30-day cache
    location ^~ /media/ {
        add_header Cache-Control "public, max-age=2592000" always;
        try_files /static$uri =404;
    }

    # Everything else: static files only
    # Try pre-rendered HTML, then XML (RSS/sitemap), then bare file, then 404
    location / {
        try_files /static$uri/index.html /static$uri/index.xml /static$uri $uri =404;
    }

    # Deny hidden files
    location ~ /\. { deny all; }
}
