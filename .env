# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=true
# DEMO/PLACEHOLDER VALUE - CREATE .env.local AND OVERRIDE THERE FOR PRODUCTION DEPLOYMENT
# Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=changeme
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/mailer ###
MAILER_DSN=smtp://localhost:1025
###< symfony/mailer ###

###> Cloudflare Web Analytics ###
CF_ANALYTICS_TOKEN=
###< Cloudflare Web Analytics ###

###> Cloudflare Turnstile ###
# DEMO/PLACEHOLDER VALUES - CREATE .env.local AND OVERRIDE THERE FOR PRODUCTION DEPLOYMENT
# Get your keys from: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
###> Cloudflare Turnstile ###

###> docker compose ###
# Site URL - needs to be same as `base_url` in
URL=example.com

# nginx port exposed on the host (default: 8123)
NGINX_PORT=8123

# Certificate Resolver
CERTRESOLVER=le
#CERTRESOLVER=dummy

# Docker User Settings - type `id` to get
UID=1000
GID=1000

# Restart containers (no | always | on-failure | unless-stopped)
RESTART=always

# PHP
PHP_VERSION=8.5-fpm-alpine
###< docker compose ###

###> Update and backup ###
# Autoupdate Containers
AUTO_UPDATE=1

# Backup variables
BCK_FILES_DIRS=.env.local
BCK_FILES_OLD_NUMBER=7
BCK_UPLOAD=1
###< Update and backup ###
