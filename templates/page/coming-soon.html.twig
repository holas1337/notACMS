{% extends 'base.html.twig' %}

{% block title %}{{ 'coming_soon.title'|trans }} | {{ site_name }}{% endblock %}
{% block meta_description %}{{ 'coming_soon.description'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block body %}
<div class="coming-soon">
    <h1>{{ 'coming_soon.heading'|trans }}</h1>
    {% if post.date() %}
        {% set days_until = (((post.date()|date('U') - "now"|date('U')) / 86400)|round(0, 'ceil')) %}
        {% if days_until <= coming_soon_reveal_days %}
            <p>{{ post.date()|date('Y-m-d') }}</p>
        {% endif %}
    {% endif %}
    <a href="{{ path('home_' ~ locale) }}">{{ 'error.go_home'|trans }}</a>
</div>
{% endblock %}