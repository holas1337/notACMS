{% extends 'base.html.twig' %}

{% block title %}{{ content.title() }} | {{ site_name }}{% endblock %}
{% block meta_description %}{{ content.description() ?: content.excerpt(meta_description_length) }}{% endblock %}
{% block og_title %}{{ content.title() }}{% endblock %}

{% block structured_data %}
<script type="application/ld+json">{{ {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": site_author.name|default(site_name),
    "url": site_base_url ~ content_url('about', locale),
    "jobTitle": 'about.role'|trans,
    "description": content.description() ?: content.excerpt(meta_description_length)
}|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES'))|raw }}</script>
{% endblock %}

{% block body %}
<article data-pagefind-body>

    {{ include('components/about_profile.html.twig', {
        author: site_author,
        role: 'about.role'|trans,
        headline: 'about.headline'|trans
    }) }}

    <div class="page-body about-bio prose">
        {{ content.htmlContent|srcset_media|raw }}
    </div>

    {% if site_author.skills is defined and site_author.skills is not empty %}
    <section class="about-skills mt-5">
        <h2>{{ 'about.skills_title'|trans }}</h2>
        <dl>
            {% for category, items in site_author.skills %}
            <div class="about-skills__group">
                <dt>{{ ('about.skills.' ~ category)|trans }}</dt>
                <dd>
                    {% for skill in items %}
                        <span class="badge">{{ skill }}</span>
                    {% endfor %}
                </dd>
            </div>
            {% endfor %}
        </dl>
    </section>
    {% endif %}

    {% if site_author.recommendations is defined and site_author.recommendations is not empty %}
    <section class="about-recommendations mt-5">
        <h2>{{ 'about.recommendations_title'|trans }}</h2>
        {% for rec in site_author.recommendations %}
        {{ include('components/recommendation_card.html.twig', {
            rec: rec,
            expand_label: 'about.recommendation_expand'|trans,
            collapse_label: 'about.recommendation_collapse'|trans,
            via_label: 'about.recommendation_via'|trans
        }) }}
        {% endfor %}
    </section>
    {% endif %}

    <p>
        <a href="{{ path('contact_' ~ locale) }}" class="btn btn-primary">{{ 'about.cta_link'|trans }}</a>
    </p>

</article>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('lightbox.js') }}" defer></script>
{% if content.hasToc() %}
<script src="{{ asset('table-of-contents.js') }}" defer></script>
{% endif %}
{% if site_author.recommendations is defined and site_author.recommendations is not empty %}
<script src="{{ asset('recommendation-expand.js') }}" defer></script>
{% endif %}
{% endblock %}
