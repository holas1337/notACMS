{% extends 'base.html.twig' %}

{% block title %}{{ 'error.title'|trans }} {{ status_code }} | {{ site_name }}{% endblock %}
{% block meta_description %}{{ 'error.title'|trans }} {{ status_code }}: {{ status_text }}{% endblock %}

{% block body %}
<div class="error-page">
    <div class="error-code">{{ status_code }}</div>
    <h1>{{ 'error.title'|trans }}</h1>
    <p>{{ status_text }}</p>
    <a href="{{ path('home_' ~ locale) }}">{{ 'error.go_home'|trans }}</a>
</div>
{% endblock %}