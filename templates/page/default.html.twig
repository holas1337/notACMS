{% extends 'base.html.twig' %}

{% block title %}{{ content.title() }} | {{ site_name }}{% endblock %}
{% block meta_description %}{{ content.description() ?: content.excerpt(meta_description_length) }}{% endblock %}
{% block og_title %}{{ content.title() }}{% endblock %}

{% block structured_data %}{{ json_ld(structured_data().webPage(
    content.title(),
    site_base_url ~ app.request.pathInfo,
    content.description() ?: content.excerpt(meta_description_length)
)) }}{% endblock %}

{% block body %}
{{ include('components/breadcrumb.html.twig', { breadcrumbs: breadcrumbs(content, locale, {home_label: site_name}) }) }}

<div class="container container--prose">
{{ include('components/page_article.html.twig') }}
</div>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('lightbox.js') }}" defer></script>
{% if content.hasToc() %}
<script src="{{ asset('table-of-contents.js') }}" defer></script>
{% endif %}
{% endblock %}
