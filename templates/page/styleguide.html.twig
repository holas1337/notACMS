    {# ── 31. IMAGE UTILITIES ──────────────────────────────────────────────────── #}
    <section class="sg-section">
        <h2 class="sg-section__title">Image Utilities</h2>

        <h3>.alignleft / .alignright / .aligncenter</h3>
        <div class="post-body" style="min-height:120px">
            <img src="{{ dummyPosts[0].image() }}" alt="" style="width:160px" class="alignleft">
            <p>Text wrapping around a left-aligned image (<code>.alignleft</code>).</p>
            <div style="clear:both"></div>
        </div>

        <h3>figure + figcaption</h3>
        <div class="post-body">
            <figure>
                <img src="{{ dummyPosts[0].image() }}" alt="Example figure" style="max-width:400px">
                <figcaption>This is a figcaption — image description shown below the image.</figcaption>
            </figure>
        </div>

        <h3>Lightbox trigger (data-full attribute)</h3>
        <div class="post-body">
            <img src="{{ dummyPosts[0].image() }}"
                 alt="Click to open lightbox"
                 style="width:240px;cursor:pointer"
                 data-full="{{ dummyPosts[0].image() }}">
        </div>
    </section>

