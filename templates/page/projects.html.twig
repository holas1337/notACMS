{% extends 'base.html.twig' %}

{% block title %}{{ content.title() }} | {{ site_name }}{% endblock %}
{% block meta_description %}{{ content.description() }}{% endblock %}
{% block og_title %}{{ content.title() }}{% endblock %}

{% block structured_data %}{{ json_ld(structured_data().webPage(
    content.title(),
    site_base_url ~ app.request.pathInfo,
    content.description()
)) }}{% endblock %}

{% block body %}
{{ include('components/breadcrumb.html.twig', { breadcrumbs: breadcrumbs(content, locale, {home_label: site_name}) }) }}

<div class="projects-page">
    {{ include('components/page_article.html.twig', { show_image: false }) }}

    {% if featured_projects is defined and featured_projects is not empty %}
    <ul class="projects-list">
        {% for project in featured_projects %}
        <li>
            <a href="{{ project.url() }}">
                <strong>{{ project.title() }}</strong>
                <p>{{ project.description() }}</p>
            </a>
        </li>
        {% endfor %}
    </ul>
    {% endif %}

    <p>
        <a href="{{ path('blog_category_' ~ locale, {category: content.slug()}) }}">{{ 'projects.view_all'|trans({'%count%': total_projects}) }}</a>
    </p>
</div>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('lightbox.js') }}" defer></script>
{% endblock %}
