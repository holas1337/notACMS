{% extends 'base.html.twig' %}

{% block title %}{{ content.title() }} | {{ site_name }}{% endblock %}
{% block meta_description %}{{ content.description() }}{% endblock %}
{% block og_title %}{{ content.title() }}{% endblock %}

{% block body %}
{{ include('components/breadcrumb.html.twig', { breadcrumbs: [
    {label: site_name, url: path('home_' ~ locale)},
    {label: content.title()}
]}) }}

<div class="projects-page" data-pagefind-body>
    <article>
        <header class="page-header">
            <h1 data-pagefind-meta="title">{{ content.title() }}</h1>
            {% if content.description() %}
                <p class="page-header-desc">{{ content.description() }}</p>
            {% endif %}
        </header>
        <div class="page-body prose">
            {{ content.htmlContent|srcset_media|raw }}
        </div>
    </article>

    {% if featured_projects is defined and featured_projects is not empty %}
    <ul class="projects-list">
        {% for project in featured_projects %}
        <li>
            <a href="{{ project.url() }}">
                <strong>{{ project.title() }}</strong>
                <p>{{ project.description() }}</p>
            </a>
        </li>
        {% endfor %}
    </ul>
    {% endif %}

    <p>
        <a href="{{ path('blog_category_' ~ locale, {category: content.slug()}) }}">{{ 'projects.view_all'|trans({'%count%': total_projects}) }}</a>
    </p>
</div>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('lightbox.js') }}" defer></script>
{% endblock %}
