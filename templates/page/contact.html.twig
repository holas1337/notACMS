{% extends 'base.html.twig' %}

{% block title %}{{ 'contact.title'|trans }} | {{ site_name }}{% endblock %}
{% block og_title %}{{ 'contact.title'|trans }}{% endblock %}

{% block structured_data %}{{ json_ld(structured_data().contactPage(
    'contact.title'|trans,
    site_base_url ~ content_url('contact', locale)
)) }}{% endblock %}

{% block body %}
<article data-pagefind-body>
    <header class="page-header">
        <h1>{{ 'contact.title'|trans }}</h1>
    </header>

    <div class="contact-form">
        {% if content is not null %}
            <div class="contact-intro page-body prose">{{ content.htmlContent|srcset_media|raw }}</div>
        {% endif %}

        <p class="mb-3">{{ 'contact.about_nudge'|trans }} <a href="{{ content_url('about', locale) }}">{{ 'contact.about_nudge_link'|trans }}</a></p>

        {% if not (contact_form_available ?? true) %}
        <div class="alert alert-danger"><div class="alert-body">{{ 'contact.form.unavailable'|trans }}</div></div>
        {% else %}
        <div id="contact-success" class="alert alert-success is-hidden"><div class="alert-body"></div></div>
        <div id="contact-error" class="alert alert-danger is-hidden"><div class="alert-body"></div></div>

        {{ form_start(form, {
            action: path('api_contact_' ~ locale),
            attr: { id: 'contact-form', novalidate: 'novalidate' }
        }) }}

        <div class="mb-3">
            {{ form_label(form.name) }}
            {{ form_widget(form.name) }}
            <span class="form-field__error" id="error-name" role="alert"></span>
        </div>
        <div class="mb-3">
            {{ form_label(form.email) }}
            {{ form_widget(form.email) }}
            <span class="form-field__error" id="error-email" role="alert"></span>
        </div>
        <div class="mb-3">
            {{ form_label(form.website) }}
            {{ form_widget(form.website) }}
            <span class="form-field__error" id="error-website" role="alert"></span>
        </div>
        <div class="mb-3">
            {{ form_label(form.subject) }}
            {{ form_widget(form.subject) }}
            <span class="form-field__error" id="error-subject" role="alert"></span>
        </div>
        <div class="mb-3">
            {{ form_label(form.message) }}
            {{ form_widget(form.message) }}
            <span class="form-field__error" id="error-message" role="alert"></span>
        </div>

        {% if turnstile_site_key %}
        <div class="mb-3">
            <div class="cf-turnstile"
                 data-sitekey="{{ turnstile_site_key }}"
                 data-callback="onTurnstileSuccess"
                 data-theme="light"></div>
        </div>
        {{ form_widget(form.turnstile_token) }}
        {% endif %}

        <div class="mb-3">
            <button type="submit" id="contact-submit">{{ 'contact.form.send'|trans }}</button>
        </div>

        {{ form_end(form) }}
        {% endif %}
    </div>
</article>
{% endblock %}

{% block head_preconnect %}
{% if turnstile_site_key %}
<link rel="preconnect" href="https://challenges.cloudflare.com" crossorigin>
{% endif %}
{% endblock %}

{% block javascripts %}
{{ parent() }}
{% if turnstile_site_key %}
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async></script>
{% endif %}
<script src="{{ asset('lightbox.js') }}" defer></script>
<script src="{{ asset('contact.js') }}" defer></script>
{% endblock %}