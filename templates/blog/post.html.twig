{% extends 'base.html.twig' %}

{% block title %}{{ content.title() }} | {{ site_name }}{% endblock %}
{% block meta_description %}{{ content.description() ?: content.excerpt(meta_description_length) }}{% endblock %}
{% block og_type %}article{% endblock %}
{% block og_title %}{{ content.title() }}{% endblock %}

{% block og_article_meta %}
{% if content.date() %}
<meta property="article:published_time" content="{{ content.date()|date('c') }}">
{% endif %}
{% if content.updatedDate() %}
<meta property="article:modified_time" content="{{ content.updatedDate()|date('c') }}">
{% endif %}
<meta property="article:author" content="{{ site_base_url }}{{ content_url('about', locale) }}">
{% if content.category() %}
<meta property="article:section" content="{{ content.category() }}">
{% endif %}
{% for tag in content.tags() %}
<meta property="article:tag" content="{{ tag }}">
{% endfor %}
{% endblock %}

{% block structured_data %}{{ json_ld(structured_data().blogPosting({
    headline: content.title(),
    url: site_base_url ~ app.request.pathInfo,
    inLanguage: locale,
    datePublished: content.date() ? content.date()|date('c') : '',
    dateModified: content.updatedDate() ? content.updatedDate()|date('c') : (content.date() ? content.date()|date('c') : null),
    description: content.description() ?: content.excerpt(meta_description_length),
    wordCount: content.wordCount(),
    articleSection: content.category() ?: null,
    keywords: content.tags(),
    author: structured_data().person(site_author.name|default(site_name), site_base_url ~ content_url('about', locale)),
    publisher: structured_data().organization(site_name, site_base_url)
})) }}{% endblock %}

{% block body %}
<div class="container container--post">
{{ include('components/breadcrumb.html.twig', { breadcrumbs: breadcrumbs(content, locale) }) }}

<article data-pagefind-body>
    <header class="post-header">
        {% if content.isDraft() %}<div class="alert alert-warning">{{ 'blog.draft_banner'|trans }}</div>{% endif %}
        {% if content.isScheduled() %}<div class="alert alert-info">{{ 'blog.scheduled_banner'|trans({'%date%': content.date()|date('Y-m-d')}) }}</div>{% endif %}
        {{ include('components/featured_image.html.twig', { item: content, sizes: '(max-width: 48em) 100vw, 720px' }) }}
        <h1 data-pagefind-meta="title">{{ content.title() }}</h1>
        <p class="post-meta">
            {% if content.category() %}
                <a href="{{ path('blog_category_' ~ locale, {category: content.category()}) }}">{{ content.category() }}</a> &bull;
                <span hidden data-pagefind-meta="category">{{ content.category() }}</span>
            {% endif %}
            {% if content.date() %}
                <time datetime="{{ content.date()|date('Y-m-d') }}">{{ content.date()|date(site_locales[locale].date_format) }}</time>
                <span hidden data-pagefind-meta="date">{{ content.date()|date(site_locales[locale].date_format) }}</span>
            {% endif %}
            {% if content.updatedDate() %}
                &bull; <time datetime="{{ content.updatedDate()|date('Y-m-d') }}">{{ 'blog.updated_on'|trans }}: {{ content.updatedDate()|date(site_locales[locale].date_format) }}</time>
            {% endif %}
            &bull; {{ 'blog.reading_time'|trans({'%count%': content.readingTime()}) }}
        </p>
        {% if content.description() %}
            <p class="post-lead">{{ content.description() }}</p>
        {% endif %}
    </header>

    {{ include('components/series_nav.html.twig') }}

    <div class="post-content prose">
        {{ content.htmlContent|srcset_media|raw }}
    </div>

    <footer class="post-footer">
        {% if content.tags() is not empty %}
            <div class="post-tags" data-pagefind-ignore>
                <span>{{ 'blog.tags'|trans }}:</span>
                {% for tag in content.tags() %}
                    <a href="{{ path('blog_tag_' ~ locale, {tag: tag}) }}">#{{ tag }}</a>
                {% endfor %}
            </div>
        {% endif %}

        {{ include('components/share_buttons.html.twig', { title: content.title() }) }}
    </footer>
</article>

{{ include('components/post_navigation.html.twig') }}

{% if related_posts is defined and related_posts is not empty %}
<section class="related-posts" data-pagefind-ignore>
    <h2>{{ 'blog.related_posts'|trans }}</h2>
    <ul>
        {% for post in related_posts %}
            {{ include('components/post_card_mini.html.twig') }}
        {% endfor %}
    </ul>
</section>
{% endif %}
</div>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('code-copy.js') }}" defer></script>
<script src="{{ asset('copy-link.js') }}" defer></script>
<script src="{{ asset('lightbox.js') }}" defer></script>
{% if content.hasToc() %}
<script src="{{ asset('table-of-contents.js') }}" defer></script>
{% endif %}
<script src="{{ asset('reading-progress.js') }}" defer></script>
{% endblock %}
