{% extends 'base.html.twig' %}

{% set filter_title = blog_filter_title(
    filter_type|default(null),
    filter_value|default(null),
    archive_year|default(null),
    archive_month|default(null),
    locale
) %}

{% block title %}{{ filter_title }} | {{ site_name }}{% endblock %}

{% block og_title %}{{ filter_title }}{% endblock %}

{% block meta_description %}{% if filter_type is defined and filter_type is same as('category') %}{{ 'blog.meta.category'|trans({'%category%': filter_value|capitalize}) }}{% elseif filter_type is defined and filter_type is same as('tag') %}{{ 'blog.meta.tag'|trans({'%tag%': filter_value}) }}{% elseif filter_type is defined and filter_type is same as('archive') %}{% if archive_month is defined %}{{ 'blog.meta.archive_month'|trans({'%date%': filter_title}) }}{% else %}{{ 'blog.meta.archive_year'|trans({'%year%': archive_year}) }}{% endif %}{% else %}{{ 'blog.meta.index'|trans }}{% endif %}{% endblock %}

{% block structured_data %}{{ json_ld(structured_data().collectionPage(
    block('title'),
    site_base_url ~ app.request.pathInfo,
    posts|map((post, i) => {
        "@type": "ListItem",
        "position": i + 1,
        "url": site_base_url ~ post.url()
    }),
    block('meta_description')
)) }}{% endblock %}

{% block body %}
<div class="page-content">
{{ include('components/breadcrumb.html.twig', { breadcrumbs: breadcrumbs(null, locale, {filter_type: filter_type|default(null), filter_value: filter_value|default(null), archive_date: filter_title}) }) }}

<header class="archive-header">
    <h1>{{ filter_title }}</h1>
</header>

{% if posts is not empty %}
    <div class="post-list">
    {% for post in posts %}
        {{ include('components/post_card.html.twig', { post: post, featured: post.isPinned() }) }}
    {% endfor %}
    </div>

    {% if filter_type is not defined or filter_type is null %}
        {{ include('components/pagination.html.twig', {
            base_url: path('blog_list_' ~ locale),
            paginated_route: 'blog_list_paginated_' ~ locale,
            current_page: current_page,
            total_pages: total_pages,
        }) }}
    {% endif %}
{% else %}
    <p>{{ 'blog.no_posts'|trans }}</p>
{% endif %}
</div>
{% endblock %}
