{# Shared profiler toolbar item for the draft/scheduled preview toggles.
   Expects: collector, label (string), title (string), toggle_route (string), icon_svg (safe SVG markup) #}
{% set status = collector.enabled ? 'red' : 'default' %}
{% set icon %}
    {{ icon_svg|raw }}
    <span class="sf-toolbar-label">{{ label }}</span>
    <span class="sf-toolbar-value">{{ collector.enabled ? 'ON' : 'OFF' }}</span>
{% endset %}
{% set text %}
    <div class="sf-toolbar-info-piece">
        <b>{{ title }}</b>
        <span>{{ collector.enabled ? 'Enabled' : 'Disabled' }}</span>
    </div>
    <div class="sf-toolbar-info-piece">
        <a href="{{ path(toggle_route) }}">{{ collector.enabled ? 'Disable' : 'Enable' }}</a>
    </div>
{% endset %}
{{ include('@WebProfiler/Profiler/toolbar_item.html.twig', { link: false, status: status }) }}
