{% set other_locales = [] %}
{% for l in site_locales_list %}
    {% if l is not same as(locale) %}
        {% set other_locales = other_locales|merge([l]) %}
    {% endif %}
{% endfor %}

{% if other_locales is not empty %}

{% set switch_urls = lang_switch_urls(other_locales) %}

<div class="lang-switcher">
    <a href="{{ app.request.pathInfo }}" aria-current="page" class="lang-switcher__link lang-switcher__link--active">{{ locale|upper }}</a>
    {% for other, url in switch_urls %}
        <span class="lang-sep">/</span>
        <a href="{{ url }}" class="lang-switcher__link lang-switch" hreflang="{{ other }}" lang="{{ other }}">{{ other|upper }}</a>
    {% endfor %}
</div>

{% endif %}
