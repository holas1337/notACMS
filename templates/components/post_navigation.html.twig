{% if (prev_post is defined and prev_post) or (next_post is defined and next_post) %}
<nav class="post-navigation flex-between border-top pt-4" aria-label="{{ 'blog.post_navigation'|trans }}" data-pagefind-ignore>
    {% if prev_post %}
        <a href="{{ prev_post.url() }}">
            <span>{{ 'nav.prev'|trans }}</span>
            <span>{{ prev_post.title() }}</span>
        </a>
    {% else %}
        <div></div>
    {% endif %}
    {% if next_post %}
        <a href="{{ next_post.url() }}">
            <span>{{ 'nav.next'|trans }}</span>
            <span>{{ next_post.title() }}</span>
        </a>
    {% else %}
        <div></div>
    {% endif %}
</nav>
{% endif %}
