{% set current_path = app.request.pathInfo %}
{% set home_url = path('home_' ~ locale) %}
{% set blog_url = path('blog_list_' ~ locale) %}
{% set about_url = content_url('about', locale) %}
{% set contact_url = path('contact_' ~ locale) %}
{% set is_blog = current_path starts with blog_url or current_path matches '#^/([a-z]{2}/)?\\d{4}/#' %}

{% set nav_items = [
    { label: 'nav.home'|trans,     url: home_url,  active: current_path is same as(home_url) },
    { label: 'nav.blog'|trans,    url: blog_url,   active: is_blog },
    { label: 'nav.about'|trans,   url: about_url,  active: current_path is same as(about_url) },
    { label: 'nav.contact'|trans, url: contact_url, active: current_path is same as(contact_url) },
] %}

<nav aria-label="{{ 'nav.main'|trans }}">
    <button class="nav-toggle" aria-expanded="false" aria-controls="nav-list" aria-label="{{ 'nav.menu'|trans }}">
        <span class="nav-toggle__bar"></span>
        <span class="nav-toggle__bar"></span>
        <span class="nav-toggle__bar"></span>
    </button>

    <ul id="nav-list">
    {% for item in nav_items %}
        <li class="nav-item{{ item.active ? ' nav-item--active' : '' }}">
            <a href="{{ item.url }}"{% if item.active %} aria-current="page"{% endif %}>{{ item.label }}</a>
        </li>
    {% endfor %}
    </ul>
</nav>

{{ include('components/language_switcher.html.twig') }}