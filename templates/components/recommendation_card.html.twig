<blockquote class="recommendation-card">
    <p class="recommendation-quote">{{ rec.quote }}</p>
    {% if rec.text is defined and rec.text is not empty %}
    <button class="recommendation-expand" type="button"
        aria-expanded="false"
        data-expand="{{ expand_label }}"
        data-collapse="{{ collapse_label }}">
        {{ expand_label }}
    </button>
    <div class="recommendation-full" hidden>
        {%- for para in rec.text|split('\n\n') %}
        <p>{{ para|trim }}</p>
        {%- endfor %}
    </div>
    {% endif %}
    <footer class="recommendation-footer">
        <span class="recommendation-author">{{ rec.name }}</span>
        <span class="recommendation-role">{{ rec.role }}</span>
    </footer>
</blockquote>
