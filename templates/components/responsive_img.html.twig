{% set _base = src[0:-5] %}
<img src="{{ src }}"
     srcset="{% for w in image_variant_widths %}{{ _base }}-{{ w }}w.webp {{ w }}w, {% endfor %}{{ src }} {{ width|default(1280) }}w"
     sizes="{{ sizes|default('(max-width: 48em) 100vw, 720px') }}"
     alt="{{ alt }}"
     width="{{ width|default(1280) }}"
     height="{{ height|default(720) }}"
     loading="{{ loading|default('lazy') }}"
     {% if fetchpriority is defined and fetchpriority %}fetchpriority="{{ fetchpriority }}"{% endif %}
     {% if pagefind ?? false %}data-pagefind-meta="image[src]"{% endif %}>
