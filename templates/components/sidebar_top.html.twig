{% if sidebar is defined %}
<div class="widget">
    <h3>{{ 'sidebar.search'|trans }}</h3>
    <form class="widget-search" action="{{ path('search_' ~ locale) }}" method="get">
        <input type="search" name="q" placeholder="{{ 'sidebar.search'|trans }}&hellip;"
               aria-label="{{ 'sidebar.search'|trans }}">
        <button type="submit">{{ 'sidebar.search'|trans }}</button>
    </form>
</div>
{% endif %}