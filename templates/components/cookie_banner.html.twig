<div id="cookie-banner" class="cookie-banner is-hidden">
    <p>{{ 'cookie.banner_text'|trans }} <a href="{{ privacy_url }}">{{ 'common.privacy_policy'|trans }}</a></p>
    <div class="cookie-banner__actions">
        <button id="cookie-accept">{{ 'cookie.accept'|trans }}</button>
        <button id="cookie-dismiss" aria-label="{{ 'cookie.dismiss'|trans }}">&times;</button>
    </div>
</div>
