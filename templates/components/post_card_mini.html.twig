<div class="post-card-mini{% if post.isScheduled() %} post-card-mini--scheduled{% endif %}">
    {% if post.image() %}
    <div class="post-card-mini__image">
        {{ include('components/responsive_img.html.twig', {
            src: post.image(),
            alt: post.imageAlt(),
            sizes: '80px'
        }) }}
    </div>
    {% endif %}
    <div class="post-card-mini__body">
        <a href="{{ post.url() }}" class="post-card-mini__title">
            {{ post.title() }}
            {% if post.isScheduled() %}<span class="post-card-badge post-card-badge--planned">{{ 'badge.planned'|trans }}</span>{% endif %}
        </a>
        <span class="post-card-mini__meta">
            {{ include('components/post_meta_line.html.twig') }}
        </span>
    </div>
</div>
